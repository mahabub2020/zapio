{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .footer-simple {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .footer-simple__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-simple__logo {
    flex: 0 0 auto;
  }

  .footer-simple__logo img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  .footer-simple__logo-text {
    font-size: 2.4rem;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  .footer-simple__menu {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
    gap: 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-simple__menu a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 1.5rem;
    transition: opacity 0.3s ease;
  }

  .footer-simple__menu a:hover {
    opacity: 0.7;
  }

  .footer-simple__social {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
  }

  .footer-simple__social a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    transition: opacity 0.3s ease;
  }

  .footer-simple__social a:hover {
    opacity: 0.7;
  }

  .footer-simple__content--social-hidden .footer-simple__menu {
    justify-content: flex-end;
  }

  @media screen and (max-width: 989px) {
    .footer-simple__content {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .footer-simple__menu {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
{%- endstyle -%}

<footer class="footer footer-simple section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="footer-simple__content{% unless section.settings.show_social_link %} footer-simple__content--social-hidden{% endunless %}">
      {%- comment -%} Logo {%- endcomment -%}
      <div class="footer-simple__logo">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}">
            <img
              src="{{ section.settings.logo | image_url: width: 600 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="lazy"
            >
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="footer-simple__logo-text">
            {{ shop.name }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Menu {%- endcomment -%}
      {%- if section.settings.menu != blank -%}
        <nav class="footer-simple__menu">
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- comment -%} Social Link {%- endcomment -%}
      {%- if section.settings.show_social_link -%}
        {%- if section.settings.social_text != blank and section.settings.social_link != blank -%}
          <div class="footer-simple__social">
            <span>{{ section.settings.social_text }}</span>
            <a href="{{ section.settings.social_link }}" target="_blank" rel="noopener">
              {{ section.settings.social_link_text }}
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Social link"
    },
    {
      "type": "checkbox",
      "id": "show_social_link",
      "label": "Show social link",
      "default": true
    },
    {
      "type": "text",
      "id": "social_text",
      "label": "Social text",
      "default": "Follow us on:"
    },
    {
      "type": "text",
      "id": "social_link_text",
      "label": "Social link text",
      "default": "LinkedIn"
    },
    {
      "type": "url",
      "id": "social_link",
      "label": "Social link URL"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
