{{ 'section-zapio-widget-types.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (min-width: 750px) {
    .show-on-mobile {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .show-on-desktop {
      display: none;
    }
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
 
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .zapio-widget-types__card {
      height: {{ section.settings.card_height_desktop }}px;
    }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .zapio-widget-types__card {
      height: {{ section.settings.card_height_mobile }}px;
    }
  } 
  {%- for block in section.blocks -%}
    {%- if block.settings.button_hover_text_color != blank -%}
      .zapio-widget-btn-{{ block.id }}:hover {
        color: {{ block.settings.button_hover_text_color }} !important;
      }
    {%- endif -%}
    .zapio-widget-bg-{{ block.id }} {
      background-position: {{ block.settings.background_image_position | default: 'right' }};
    }
    @media screen and (max-width: 749px) {
      .zapio-widget-bg-{{ block.id }} {
        background-position: {{ block.settings.background_image_position_mobile | default: block.settings.background_image_position | default: 'center' }};
      }
    }
  {%- endfor -%}
{%- endstyle -%}

<div class="zapio-widget-types color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- comment -%} Header Section {%- endcomment -%}
    <div class="zapio-widget-types__header">
     <div class="wrp-widget-types__title">
      {%- if section.settings.title != blank -%}
        <h2 class="zapio-widget-types__title {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <div class="zapio-widget-types__subtitle"><p>{{ section.settings.subtitle }}</p></div>
      {%- endif -%} 
      
   </div>
    <div class="wrp-widget-types__title_right"> 
      {%- if section.settings.description != blank -%}
        <p class="zapio-widget-types__description">{{ section.settings.description }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button button--secondary zapio-widget-types__button"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
   </div>
    {%- comment -%} Filter and Sort Section {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="zapio-widget-types__controls">
        <div class="zapio-widget-types__filters" data-widget-filters>
          <button class="zapio-widget-types__filter-tab active" data-filter="all">All Widgets</button>
          <button class="zapio-widget-types__filter-tab" data-filter="product-page">Product page</button>
          <button class="zapio-widget-types__filter-tab" data-filter="cart-page">Cart page</button>
          {% comment %} <button class="zapio-widget-types__filter-tab" data-filter="checkout-page">Checkout page</button> {% endcomment %}
          {% comment %} <button class="zapio-widget-types__filter-tab" data-filter="thank-you-page">Thank you page</button> {% endcomment %}
          <button class="zapio-widget-types__filter-tab" data-filter="pop-up">Pop-up</button>
        </div>

        <div class="zapio-widget-types__sort">
          <label for="widget-type-{{ section.id }}">Sort by:</label>
          <select id="widget-type-{{ section.id }}" data-widget-type>
            <option value="all">All Pages</option>
            <option value="free-gift">Free Gift</option>
            <option value="bxgy-bogo">BXGY / BOGO</option>
            <option value="milestone-rewards">Milestone Rewards</option>
            {% comment %} <option value="placement">Placement</option> {% endcomment %}
          </select>
        </div>
      </div>

      {%- comment -%} Widget Cards Grid {%- endcomment -%}
      <div class="zapio-widget-types__grid zapio-widget-types__grid--{{ section.settings.columns_desktop }}-col-desktop zapio-widget-types__grid--{{ section.settings.columns_mobile }}-col-mobile" data-widget-grid>
        {%- for block in section.blocks -%}
          <!-- Debug: Rendering Block {{ block.id }} -->
          {%- liquid
            assign image_position = 'left: ' | append: block.settings.image_position_x | append: '%; top: ' | append: block.settings.image_position_y | append: '%;'
            assign card_bg_style = 'background-color: ' | append: block.settings.background_color | append: '; position: relative; overflow: hidden;'
          -%}
          <div
            class="zapio-widget-types__card zapio-widget-types__card--{{ block.settings.content_layout }}"
            data-widget-card
            {% liquid
              assign categories = ''
              if block.settings.cat_product_page
                assign categories = categories | append: 'product-page '
              endif
              if block.settings.cat_cart_page
                assign categories = categories | append: 'cart-page '
              endif
              if block.settings.cat_checkout_page
                assign categories = categories | append: 'checkout-page '
              endif
              if block.settings.cat_thank_you_page
                assign categories = categories | append: 'thank-you-page '
              endif
              if block.settings.cat_popup
                assign categories = categories | append: 'pop-up '
              endif
            %}
            data-category="{{ categories | strip }}"
            data-widget-type="{{ block.settings.widget_type }}"
            data-name="{{ block.settings.title | escape }}"
            style="{{ card_bg_style }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.background_image != blank -%}
              <div
                class="zapio-widget-types__card-bg-image zapio-widget-bg-{{ block.id }}"
                style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; background-image: url('{{ block.settings.background_image | image_url: width: 1000 }}'); background-size: {{ block.settings.background_size | default: 'cover' }};"
              > &nbsp; </div>
            {%- endif -%}

            {%- if block.settings.overlay_opacity > 0 -%}
              {%- liquid
                assign overlay_opacity_decimal = block.settings.overlay_opacity | divided_by: 100.0
              -%}
              <div
                class="zapio-widget-types__card-overlay"
                style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1; background-color: {{ block.settings.overlay_color }}; opacity: {{ overlay_opacity_decimal }};"
              > &nbsp; </div>
            {%- endif -%}

            <div class="zapio-widget-types__card-content" style="position: relative; z-index: 2;">
            
            {%- if block.settings.badge != blank -%}
                <span class="zapio-widget-types__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
                {%- if block.settings.preview_image != blank -%}
                <div class="zapio-widget-types__preview-small show-on-mobile">
                  <img
                    src="{{ block.settings.preview_image | image_url: width: 600 }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="{{ block.settings.preview_image.width }}"
                    height="{{ block.settings.preview_image.height }}"
                    style="width: 100%; height: auto;"
                  >
                </div>
              {%- endif -%}
 

              <div class="zapio-widget-types__card-text">
                {%- if block.settings.title != blank -%}
                  <h3 class="zapio-widget-types__card-title" style="font-size: {{ block.settings.title_font_size }}px; {% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <p class="zapio-widget-types__card-description" style="font-size: {{ block.settings.description_font_size }}px; {% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
                {%- endif -%}

                {%- if block.settings.list_title != blank -%}
                  <h4 class="zapio-widget-types__card-list-title" style="font-size: {{ block.settings.list_title_font_size }}px; {% if block.settings.list_title_color != blank %}color: {{ block.settings.list_title_color }};{% endif %} margin-top: 10px; margin-bottom: 4px; font-weight: 600;">{{ block.settings.list_title }}</h4>
                {%- endif -%}

                {%- assign list_items = block.settings.list_items | newline_to_br | split: '<br />' -%}
                {%- if list_items.size > 0 and block.settings.list_items != blank -%}
                  <ul class="zapio-widget-types__card-list" style="margin: 0; padding-left: 20px; list-style: disc;">
                    {%- for item in list_items -%}
                      {%- assign trimmed_item = item | strip -%}
                      {%- if trimmed_item != blank -%}
                        <li style="font-size: {{ block.settings.list_font_size }}px; {% if block.settings.list_color != blank %}color: {{ block.settings.list_color }};{% endif %} margin-bottom: 4px;">{{ trimmed_item }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="zapio-widget-types__card-link zapio-widget-btn-{{ block.id }}"
                    style="font-size: {{ block.settings.button_font_size }}px; {% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}"
                  >
                    {{ block.settings.button_label | escape }}
                    <span class="zapio-widget-types__card-arrow">{{ 'right-linear.svg' | inline_asset_content }}</span>
                  </a>
                {%- endif -%}
               
          
            </div>

            {%- if block.settings.main_image != blank -%}
              <div class="zapio-widget-types__preview-large show-on-desktop" style="{{ image_position }}">
                <img
                  src="{{ block.settings.main_image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.main_image.width }}"
                  height="{{ block.settings.main_image.height }}"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} No Results Message {%- endcomment -%}
      <div class="zapio-widget-types__no-results" data-no-results style="display: none;">
        <p>No widgets found matching your filters. Please try a different selection.</p>
      </div>

      {%- comment -%} Pagination {%- endcomment -%}
      {%- if section.settings.enable_pagination -%}
        <div class="zapio-widget-types__pagination" data-widget-pagination>
          <button class="zapio-widget-types__pagination-btn" data-pagination-prev disabled>← Previous</button>
          <div class="zapio-widget-types__pagination-pages" data-pagination-pages></div>
          <button class="zapio-widget-types__pagination-btn" data-pagination-next>Next →</button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script>
  class WidgetTypesFilter {
    constructor(container) {
      this.container = container;
      this.filters = container.querySelectorAll('[data-filter]');
      this.cards = container.querySelectorAll('[data-widget-card]');
      this.widgetTypeSelect = container.querySelector('[data-widget-type]');
      this.grid = container.querySelector('[data-widget-grid]');
      this.noResults = container.querySelector('[data-no-results]');
      this.pagination = container.querySelector('[data-widget-pagination]');
      this.itemsPerPage = {{ section.settings.items_per_page | default: 6 }};
      this.currentPage = 1;
      this.currentFilter = 'all';

      console.log('WidgetTypesFilter initialized');
      this.init();
    }

    init() {
      this.filters.forEach(filter => {
        filter.addEventListener('click', (e) => this.handleFilter(e));
      });

      if (this.widgetTypeSelect) {
        this.widgetTypeSelect.addEventListener('change', () => this.handleWidgetType());
      }

      if (this.pagination) {
        const prevBtn = this.pagination.querySelector('[data-pagination-prev]');
        const nextBtn = this.pagination.querySelector('[data-pagination-next]');

        if (prevBtn) prevBtn.addEventListener('click', () => this.goToPage(this.currentPage - 1));
        if (nextBtn) nextBtn.addEventListener('click', () => this.goToPage(this.currentPage + 1));
      }

      this.filterAndSort();
    }

    handleFilter(e) {
      this.filters.forEach(f => f.classList.remove('active'));
      e.target.classList.add('active');
      this.currentFilter = e.target.dataset.filter;
      console.log('Filter changed to:', this.currentFilter);
      this.currentPage = 1;
      this.filterAndSort();
    }

    handleWidgetType() {
      this.currentPage = 1;
      this.filterAndSort();
    }

    filterAndSort() {
      let visibleCards = Array.from(this.cards);
      console.log(`filterAndSort running. Total cards found in DOM: ${visibleCards.length}`);
      
      if (visibleCards.length === 0) {
        console.warn('WARNING: No cards found. Dumping container HTML (first 2000 chars):', this.container.innerHTML.substring(0, 2000));
        console.log('section.blocks check - Looking for data-widget-grid:', !!this.container.querySelector('[data-widget-grid]'));
      }

      // Filter by category
      if (this.currentFilter !== 'all') {
        visibleCards = visibleCards.filter(card => {
          const categories = card.dataset.category ? card.dataset.category.split(/\s+/) : [];
          const match = categories.includes(this.currentFilter);
          console.log(`Card "${card.dataset.name}" categories:`, categories, 'Match:', match);
          return match;
        });
      }

      // Filter by widget type
      if (this.widgetTypeSelect) {
        const widgetType = this.widgetTypeSelect.value;
        if (widgetType !== 'all') {
          visibleCards = visibleCards.filter(card =>
            card.dataset.widgetType === widgetType
          );
        }
      }

      // Hide all cards first
      this.cards.forEach(card => card.style.display = 'none');

      // Check if no results
      if (visibleCards.length === 0) {
        if (this.noResults) this.noResults.style.display = 'block';
        if (this.pagination) this.pagination.style.display = 'none';
        return;
      }

      // Hide no results message
      if (this.noResults) this.noResults.style.display = 'none';

      // Show filtered cards
      if (this.pagination) {
        this.paginateCards(visibleCards);
      } else {
        visibleCards.forEach(card => card.style.display = '');
      }
    }

    paginateCards(cards) {
      const totalPages = Math.ceil(cards.length / this.itemsPerPage);

      // Hide pagination if only one page or less
      if (totalPages <= 1) {
        this.pagination.style.display = 'none';
        cards.forEach(card => card.style.display = '');
        return;
      }

      // Show pagination
      this.pagination.style.display = 'flex';

      const start = (this.currentPage - 1) * this.itemsPerPage;
      const end = start + this.itemsPerPage;

      cards.slice(start, end).forEach(card => card.style.display = '');

      this.updatePaginationControls(totalPages);
    }

    updatePaginationControls(totalPages) {
      const pagesContainer = this.pagination.querySelector('[data-pagination-pages]');
      const prevBtn = this.pagination.querySelector('[data-pagination-prev]');
      const nextBtn = this.pagination.querySelector('[data-pagination-next]');

      // Update buttons state
      prevBtn.disabled = this.currentPage === 1;
      nextBtn.disabled = this.currentPage === totalPages;

      // Update page numbers
      pagesContainer.innerHTML = '';
      for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.textContent = i;
        pageBtn.className = 'zapio-widget-types__pagination-page' + (i === this.currentPage ? ' active' : '');
        pageBtn.addEventListener('click', () => this.goToPage(i));
        pagesContainer.appendChild(pageBtn);
      }
    }

    goToPage(page) {
      this.currentPage = page;
      this.filterAndSort();
      this.container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    function initWidgetTypes(container) {
      if (container.querySelector('.zapio-widget-types')) {
        new WidgetTypesFilter(container.querySelector('.zapio-widget-types'));
      } else if (container.classList.contains('zapio-widget-types')) {
        new WidgetTypesFilter(container);
      }
    }

    // Init on load
    initWidgetTypes(document);

    // Init on Theme Editor section load
    document.addEventListener('shopify:section:load', (e) => {
      console.log('Theme Editor: Section Reloaded', e.target);
      initWidgetTypes(e.target);
    });
  });
</script>

{% schema %}
{
  "name": "Zapio Widget Types",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Section title",
      "default": "Widget Types"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore All Widgets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "label": "Number of columns on mobile"
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Card height on desktop",
      "default": 500
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Card height on mobile",
      "default": 400
    },
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "Enable pagination",
      "default": true
    },
    {
      "type": "range",
      "id": "items_per_page",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Items per page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "widget",
      "name": "Widget Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "cat_product_page",
          "label": "Product page",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "cat_cart_page",
          "label": "Cart page",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "cat_checkout_page",
          "label": "Checkout page",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "cat_thank_you_page",
          "label": "Thank you page",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "cat_popup",
          "label": "Pop-up",
          "default": false
        },
        {
          "type": "select",
          "id": "widget_type",
          "label": "Widget type",
          "options": [
            {
              "value": "free-gift",
              "label": "Free Gift"
            },
            {
              "value": "bxgy-bogo",
              "label": "BXGY / BOGO"
            },
            {
              "value": "milestone-rewards",
              "label": "Milestone Rewards"
            },
            {
              "value": "placement",
              "label": "Placement"
            }
          ],
          "default": "free-gift"
        },
        {
          "type": "header",
          "content": "Card Layout"
        },
        {
          "type": "select",
          "id": "content_layout",
          "label": "Content layout",
          "options": [
            {
              "value": "content-left",
              "label": "Content left, Image right"
            },
            {
              "value": "content-right",
              "label": "Content right, Image left"
            }
          ],
          "default": "content-left"
        },
        {
          "type": "header",
          "content": "Card Content"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "Free Gift",
          "info": "e.g., Free Gift, Buy X Get Y, Coming Soon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Widget name",
          "default": "Floating Pop-up"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique."
        },
        {
          "type": "header",
          "content": "Card Typography"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color"
        },
        {
          "type": "range",
          "id": "title_font_size",
          "min": 12,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Title font size",
          "default": 28
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description color"
